<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Startup PIN setup preview" WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="#101827" Foreground="#F8FAFC" FontFamily="Segoe UI" FontSize="16">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Window.Resources>
    <Grid Margin="16">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="600" Padding="28" CornerRadius="24" Background="#1E293B" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel>
                    <Image x:Name="Logo" Height="64" MaxWidth="220" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,20"/>
                    <TextBlock x:Name="Company" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,28"/>
                    <TextBlock Text="Protect your device" FontSize="36" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="Instructions" Foreground="#CBD5E1" Margin="0,0,0,24"/>
                    <Label Target="{Binding ElementName=Pin}" Content="Startup PIN" Foreground="White" Padding="0,0,0,8"/>
                    <PasswordBox x:Name="Pin" AutomationProperties.Name="Startup PIN" Margin="0,0,0,20"/>
                    <Label Target="{Binding ElementName=Confirmation}" Content="Confirm startup PIN" Foreground="White" Padding="0,0,0,8"/>
                    <PasswordBox x:Name="Confirmation" AutomationProperties.Name="Confirm startup PIN"/>
                    <TextBlock x:Name="Status" Foreground="#FDE68A" MinHeight="52" Margin="0,16,0,16" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="Submit" Content="Test PIN validation" Background="#93C5FD" Foreground="#0F172A" IsDefault="True"/>
                    <Button x:Name="Later" Content="Close preview" Background="#334155" Foreground="White" IsCancel="True" Margin="0,12,0,0"/>
                    <TextBlock x:Name="PreviewNotice" Text="PREVIEW ONLY · No BitLocker changes" FontSize="12" Foreground="#CBD5E1" Margin="0,24,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Viewbox>
    </Grid>
</Window>
